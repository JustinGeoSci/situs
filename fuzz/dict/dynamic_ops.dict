# dynamic_ops.dict
#
# libFuzzer's recommended dictionary for the `dynamic_ops` target, converted
# from libFuzzer's printed form (C octal escapes)
# to the dictionary file form, which reads only \\, \" and \xNN
# escapes. Each entry's use count is on the comment line above it, in
# libFuzzer's order.
#
#   cargo +nightly fuzz run dynamic_ops -- -dict=dict/dynamic_ops.dict

# uses: 502
kw001=" \x00\x00\x00"
# uses: 220
kw002="fffffff\x06"
# uses: 91
kw003="\xFF\xFF\x00\xE0\x02y\x09p"
